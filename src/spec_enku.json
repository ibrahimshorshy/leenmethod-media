 "E01_greetings": {
  "layout": "table",
  "scene": "e01_greeting",
  "kick": "Your first Kurdish words",
  "h1": "Say hello<br><span class='acc'>in Kurdish (Sorani)</span>",
  "hs": 58,
  "cols": [
   "Kurdish",
   "Say it",
   "Meaning"
  ],
  "rh": 80,
  "card_top": 700,
  "rows": [
   [
    "<span class=\"ar\" style=\"font-size:42px;direction:rtl\">سڵاو</span>",
    "<span class=\"lat\" style=\"font-size:30px;font-weight:700;color:#1E8FB8\">slaw</span>",
    "<span style=\"font-size:30px;font-weight:700;color:#041730;font-family:P,V,sans-serif\">Hello</span>"
   ],
   [
    "<span class=\"ar\" style=\"font-size:42px;direction:rtl\">چۆنیت؟</span>",
    "<span class=\"lat\" style=\"font-size:30px;font-weight:700;color:#1E8FB8\">chonit?</span>",
    "<span style=\"font-size:30px;font-weight:700;color:#041730;font-family:P,V,sans-serif\">How are you?</span>"
   ],
   [
    "<span class=\"ar\" style=\"font-size:38px;direction:rtl\">باشم، سوپاس</span>",
    "<span class=\"lat\" style=\"font-size:28px;font-weight:700;color:#1E8FB8\">bashim, supas</span>",
    "<span style=\"font-size:30px;font-weight:700;color:#041730;font-family:P,V,sans-serif\">I'm good, thanks</span>"
   ],
   [
    "<span class=\"ar\" style=\"font-size:40px;direction:rtl\">بەخێربێیت</span>",
    "<span class=\"lat\" style=\"font-size:30px;font-weight:700;color:#1E8FB8\">bexêrbêyt</span>",
    "<span style=\"font-size:30px;font-weight:700;color:#041730;font-family:P,V,sans-serif\">Welcome</span>"
   ]
  ],
  "note": "Save this and try it on the next Kurdish person you meet."
 },
 "E02_new_sounds": {
  "layout": "list",
  "scene": "e02_listen",
  "kick": "Pronunciation",
  "h1": "7 Kurdish sounds<br><span class='acc'>English doesn't have</span>",
  "hs": 58,
  "photo_h": 470,
  "list_top": 640,
  "fs": 31,
  "gap": 12,
  "items": [
   "ح <b>ḥ</b>: a breathy h from deep in the throat",
   "خ <b>kh</b>: like ch in Scottish “loch”",
   "ع <b>ʕ</b>: a squeeze in the throat",
   "غ <b>gh</b>: like a French r",
   "ق <b>q</b>: a k from the back of the throat",
   "ڕ <b>rr</b>: a rolled r, like Spanish “perro”",
   "ڵ <b>ł</b>: a heavy l, like the ll in “full”"
  ],
  "note": "Take them slowly. Listen first, then repeat out loud.",
  "note_y": 1180
 },
